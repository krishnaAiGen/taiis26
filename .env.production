# Loaded only by `npm run build` (Vite mode: production).
# Mode-specific files outrank .env.local, so these override the dev values.

VITE_REGISTRATION_TABLE=prod_taiis

# The site is served from https://cyber-conf.com/taiis2026/, so the default
# base path is already correct and VITE_BASE_PATH does not need setting.

# Turn payment on for production builds ONLY after the Edge Functions are
# deployed and their secrets are set. Until then leave this false: the form
# saves the registration and promises payment instructions by e-mail.
VITE_PAYMENT_ENABLED=false

# US$1 live-payment test entry. Set to true only while verifying live
# payments, then set back to false, rebuild and re-upload. The matching
# server gate is: npx supabase secrets set ALLOW_TEST_CATEGORY=false
VITE_SHOW_TEST_CATEGORY=false
