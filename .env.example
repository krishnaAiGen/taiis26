# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_,
# and anything exposed to the client is public — never put a service_role or
# sb_secret_* key in here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Which registrations table the app writes to.
# .env.local -> dev_taiis (development), .env.production -> prod_taiis (build).
VITE_REGISTRATION_TABLE=dev_taiis

# "true" once the payment Edge Functions are deployed. Never put the PayPal
# secret in this file — VITE_ vars ship to the browser.
VITE_PAYMENT_ENABLED=false

# Where the site is served from. Leave unset for GitHub Pages (/taiis2026/).
# Set to "/" for a custom domain serving at the root.
VITE_BASE_PATH=/taiis2026/

# Shows the US$1 live-payment test category (server gate: ALLOW_TEST_CATEGORY).
VITE_SHOW_TEST_CATEGORY=false
